# Keep the build context small and — more importantly — keep secrets out of it.
# Config for the image comes from build args, never from local env files.
.env*
!.env.docker.example

node_modules
.next
.git
.github
.vscode

# Generated by test tooling
coverage
playwright-report
test-results
.lighthouseci

# End-to-end tests and docs aren't needed to build the site
e2e
*.md

# Docker's own files
Dockerfile
.dockerignore
docker-compose*.yml
Caddyfile

# Generated
*.tsbuildinfo
