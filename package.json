{
  "name": "portfolio-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "clean": "rd /s /q .next",
    "build:clean": "npm run clean && npm run build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "build:mock": "node e2e/with-mock-api.mjs npm run build",
    "test:e2e": "node e2e/with-mock-api.mjs npm run build && playwright test",
    "test:e2e:only": "playwright test",
    "lighthouse": "node e2e/with-mock-api.mjs npm run build && node e2e/with-mock-api.mjs npx --yes @lhci/cli@0.15.1 autorun"
  },
  "dependencies": {
    "@marsidev/react-turnstile": "^1.6.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.48.0",
    "next": "^16.3.8",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10",
    "eslint-config-next": "^16.3.6",
    "javascript-obfuscator": "^5.8.1",
    "jsdom": "^30.1.1",
    "msw": "^3.0.2",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.0.3",
    "webpack-obfuscator": "^3.6.1"
  },
  "overrides": {
    "eslint-plugin-import": {
      "eslint": "$eslint"
    },
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    },
    "eslint-plugin-react": {
      "eslint": "$eslint"
    }
  },
  "allowScripts": {
    "sharp@0.35.4": true,
    "unrs-resolver@1.12.2": true,
    "msw": false
  }
}
