# Copy to .env.local for local development. Real env files stay git-ignored.
# For Docker, see .env.docker.example instead.
#
# NEXT_PUBLIC_* values are baked into the browser bundle at BUILD time, so set
# them in the build environment (Vercel project settings) before building.

# --- Local development (backend on localhost:3001) --------------------------
# Leave API_URL and API_PROXY_TARGET unset. The browser calls the backend
# directly (the backend's CORS allows http://localhost:3000).
NEXT_PUBLIC_API_URL=http://localhost:3001/api
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Cloudflare's always-passes test key; use the real site key in production.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# --- Production on Vercel + a separately hosted backend (e.g. Render) -------
# The backend's refresh cookie is SameSite=Strict, so the browser must only
# talk to THIS site. Next forwards /api/* to the backend (see next.config.ts).
#
#   NEXT_PUBLIC_API_URL=/api
#       What the browser uses: same-origin, relative.
#   API_URL=https://your-api.onrender.com/api
#       What the server uses (SSR, ISR, build-time prerender, Server Actions):
#       direct to the backend, absolute. The build FAILS if this is missing
#       while NEXT_PUBLIC_API_URL is relative.
#   API_PROXY_TARGET=https://your-api.onrender.com
#       Origin only, no /api and no trailing slash. Must be https. Build-time.
#   NEXT_PUBLIC_SITE_URL=https://your-project.vercel.app
#
# The backend must be awake while the frontend builds (pages prerender against
# it); free Render services sleep after inactivity, so hit /api/health first.

# --- GitHub Actions ---------------------------------------------------------
# CI builds (repository Variables) must use an ABSOLUTE NEXT_PUBLIC_API_URL, or
# none at all to use the mock API. Do not set it to /api there.
