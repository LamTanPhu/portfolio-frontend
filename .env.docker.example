# Copy to .env.docker and fill in. NEVER commit .env.docker.
# Used with:  docker compose --env-file .env.docker up -d --build
# No inline comments after values — comments go on their own line.
#
# EVERYTHING below except WEB_BIND / WEB_PORT is BAKED INTO THE IMAGE AT BUILD TIME
# and ships to every visitor's browser. Public values only — no secrets here, ever.
# Change a value -> rebuild:  docker compose --env-file .env.docker up -d --build

# ---- Backend API (REQUIRED unless BUILD_WITH_MOCK_API=true) ----
# Must include the /api prefix, no trailing slash. Must be reachable from:
#   1) the Docker BUILD (pages prerender against it),
#   2) the running container (server-side rendering / ISR revalidation),
#   3) the visitor's browser (client-side calls).
# A public https URL satisfies all three. Backend FRONTEND_URL must equal this site's origin.
NEXT_PUBLIC_API_URL=https://api.example.dev/api

# ---- Public site origin (canonical URLs, Open Graph, sitemap) ----
# No trailing slash. Left empty it falls back to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Cloudflare Turnstile SITE key (public). Empty = Cloudflare's always-pass test key ----
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ---- Optional asset overrides. Empty = the files shipped in public/ ----
NEXT_PUBLIC_RESUME_URL=
NEXT_PUBLIC_AMBIENT_TRACK_1_URL=
NEXT_PUBLIC_AMBIENT_TRACK_2_URL=
NEXT_PUBLIC_AMBIENT_TRACK_3_URL=

# ---- Smoke-test build with no backend (fixtures). NEVER deploy an image built this way ----
BUILD_WITH_MOCK_API=false

# ---- Build tooling ----
NODE_VERSION=26

# ---- Host port mapping (runtime only) ----
# 127.0.0.1 = this machine only. 0.0.0.0 = reachable on your LAN.
WEB_BIND=127.0.0.1
WEB_PORT=3000
