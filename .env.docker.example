# Copy to .env.docker and fill in. Most of these become BUILD ARGS: changing one
# means rebuilding the image (docker compose --env-file .env.docker up -d --build).

# Public URL of your backend API, ending in /api. Visitors' browsers call it
# directly, so it must be reachable from the internet — and from the Docker build.
NEXT_PUBLIC_API_URL=https://api.example.com/api

# Public URL of THIS site (canonical links, Open Graph, sitemap). No trailing slash.
# An https:// URL also switches on HSTS and upgrade-insecure-requests.
NEXT_PUBLIC_SITE_URL=https://example.com

# Cloudflare Turnstile *site* key. Leave empty ONLY for local testing: it then
# falls back to Cloudflare's "always passes" test key, i.e. no bot protection.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Compression. "true" = Node gzips (fine for a bare `docker run`).
# "false" = use with `--profile proxy`: Caddy compresses instead, and the app
# serves ~1.7x more requests per second in my test.
NEXT_COMPRESS=true

# Used by `--profile proxy`: your domain, e.g. example.com (or leave as localhost).
SITE_ADDRESS=localhost

# Optional
# NEXT_PUBLIC_RESUME_URL=
# WEB_PORT=3000
# WEB_BIND=127.0.0.1      # 0.0.0.0 to publish the port directly (no proxy)
